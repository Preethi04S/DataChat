GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
BOOKS_CSV_PATH=data/books.csv
LLM_MODE=groq
MAX_SCAN_ROWS=100000
MAX_RETURN_ROWS=50
MAX_QUESTION_LENGTH=500
RATE_LIMIT_TOKENS=20
RATE_LIMIT_REFILL_PER_SEC=2.0
CACHE_MAX_SIZE=256
LOG_LEVEL=INFO
SESSION_SECRET=generate-a-secure-random-string-here
CORS_ORIGINS=*
ENABLE_CORS=true
MAX_UPLOAD_SIZE_MB=50
METRICS_ENABLED=true
